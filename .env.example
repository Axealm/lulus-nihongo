# 誤り報告フォームの URL(BR-R2、BR-R3)。未設定のあいだ「誤りを報告」ボタンは表示されない。
# {id} は問題 ID、{version} はアプリのバージョンに置き換わる。
# Google フォームの「事前入力した URL を取得」で作った URL の、該当する値を {id} と {version} に書き換える。
# 例: https://docs.google.com/forms/d/e/XXXX/viewform?usp=pp_url&entry.111111={id}&entry.222222={version}
VITE_REPORT_FORM_URL=

# 学校・企業向けの問い合わせフォームの URL。未設定のあいだ、紹介画面にリンクは表示されない。
VITE_CONTACT_FORM_URL=
