{
  "name": "jft-basic-prep",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run validate && npm run typecheck && vite build && node scripts/build-articles.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "audio": "node scripts/generate-audio.mjs",
    "review": "node scripts/export-review.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name lulus-nihongo --branch main --commit-dirty=true"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.7",
    "jsdom": "^31.0.1",
    "marked": "^18.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
